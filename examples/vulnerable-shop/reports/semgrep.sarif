{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.90.0",
          "rules": [
            {
              "id": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
              "shortDescription": {"text": "Detected possible formatted SQL query"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {
                "tags": ["CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')", "security"],
                "security-severity": "7.5"
              }
            },
            {
              "id": "python.requests.security.disabled-cert-validation.disabled-cert-validation",
              "shortDescription": {"text": "Certificate verification has been explicitly disabled"},
              "defaultConfiguration": {"level": "error"},
              "properties": {"tags": ["CWE-295: Improper Certificate Validation", "security"], "security-severity": "7.4"}
            },
            {
              "id": "python.django.security.injection.raw-html-format.raw-html-format",
              "shortDescription": {"text": "Manually-constructed HTML from user input"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {"tags": ["CWE-79: Cross-site Scripting", "security"], "security-severity": "6.1"}
            },
            {
              "id": "python.lang.security.audit.eval-detected.eval-detected",
              "shortDescription": {"text": "Detected the use of eval()"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {"tags": ["CWE-95: Eval Injection", "security"], "security-severity": "6.5"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.formatted-sql-query.formatted-sql-query",
          "level": "warning",
          "message": {"text": "Detected possible formatted SQL query. Use parameterized queries instead."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "shop/db.py"},
            "region": {"startLine": 13, "snippet": {"text": "    return conn.execute(f\"SELECT name, email FROM users WHERE name = '{name}'\").fetchall()"}}}}]
        },
        {
          "ruleId": "python.requests.security.disabled-cert-validation.disabled-cert-validation",
          "level": "error",
          "message": {"text": "Certificate verification has been explicitly disabled."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "shop/http_client.py"},
            "region": {"startLine": 7, "snippet": {"text": "    response = requests.get(url, verify=False, timeout=10)"}}}}]
        },
        {
          "ruleId": "python.django.security.injection.raw-html-format.raw-html-format",
          "level": "warning",
          "message": {"text": "Detected user input flowing into a manually constructed HTML string."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "shop/legacy_views.py"},
            "region": {"startLine": 22, "snippet": {"text": "    return HttpResponse('<h1>' + request.GET['q'] + '</h1>')"}}}}]
        },
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "level": "warning",
          "message": {"text": "Detected the use of eval()."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "shop/catalog.py"},
            "region": {"startLine": 11, "snippet": {"text": "    return eval(name)"}}}}]
        }
      ]
    }
  ]
}
